{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true
    },
    "slug": {
      "type": "uid",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true
    },
    "content": {
      "type": "blocks",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images", "files"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "mappedBy": "tag"
    },
    "content_type_editorial": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "news",
        "economy",
        "investigation",
        "fact check",
        "interview",
        "documentation",
        "map",
        "media",
        "opinion",
        "feature"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "breaking": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "external_url": {
      "type": "string"
    },
    "meta_title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "meta_description": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "og_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "canonical_url": {
      "type": "string"
    },
    "gallery": {
      "type": "component",
      "component": "article.image-block",
      "repeatable": true
    },
    "discussion_posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::discussion-post.discussion-post",
      "mappedBy": "referenced_article"
    },
    "excerpt": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "breaking_until": {
      "type": "datetime"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "related_articles"
    },
    "related_articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "articles"
    },
    "highlight": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}