{
  "kind": "collectionType",
  "collectionName": "discussion_posts",
  "info": {
    "singularName": "discussion-post",
    "pluralName": "discussion-posts",
    "displayName": "discussion_post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "display_name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "anonymous": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "content": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "referenced_article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article",
      "inversedBy": "discussion_posts"
    },
    "post_status": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "Pending",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ]
    },
    "reviewed_by": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "admin::user"
    },
    "published_at_dt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
